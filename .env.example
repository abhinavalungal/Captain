# --- Database: Supabase project rpiuxplctquqwqvmgxqk -----------------------------
# Admin connection, for `node db/setup.js` ONLY (schema, roles, test data, checks).
# The server never reads it; do not set it on the host that runs the server.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rpiuxplctquqwqvmgxqk.supabase.co:5432/postgres

# What the server uses: two least-privilege roles that db/setup.js creates. It
# sets their passwords and writes these two lines into .env for you.
KRIS_READ_URL=postgresql://kris_reader:[YOUR-PASSWORD]@db.rpiuxplctquqwqvmgxqk.supabase.co:5432/postgres
KRIS_WRITE_URL=postgresql://kris_writer:[YOUR-PASSWORD]@db.rpiuxplctquqwqvmgxqk.supabase.co:5432/postgres
# db.<ref>.supabase.co is IPv6-only. On an IPv4-only network or host (Render, most
# offices), use the Session pooler from Supabase → Connect instead: host
# aws-0-<region>.pooler.supabase.com, port 5432, user postgres.rpiuxplctquqwqvmgxqk
# (db/setup.js then writes kris_reader.rpiuxplctquqwqvmgxqk and kris_writer.rpiuxplctquqwqvmgxqk).
# No ?sslmode=... suffix: TLS is on by default and a sslmode in the URL overrides it.
KRIS_PG_SSL=true

# Supabase API. Not used by the server: K.R.1.S reads Postgres directly, and its
# schema (kris) is not exposed to the Data API, so this key cannot reach it.
# The publishable key is public by design; never put a service-role or secret key here.
SUPABASE_URL=https://rpiuxplctquqwqvmgxqk.supabase.co
SUPABASE_ANON_KEY=sb_publishable_jrXPDD4YSF7H42WYD2nWmw_R6GziXU3
KRIS_PG_POOL_MAX=10                 # read connections per server process (each is held only while records are read)

# Veson IMOS
VESON_API_TOKEN=
VESON_LEGWISE_API=https://api.veslink.com/v1/imos/reports/FuelEU_Leg_Wise
VESON_OFFHIRE_API=https://api.veslink.com/v1/imos/reports/FuelEU_Off_Hire

# Geoform
GEOFORM_API=https://perform.geoserves.com/api/library/api/v1.1/getallforms
GEOFORM_API_KEY_HEADER=library-api
GEOFORM_API_KEY=

# Sync
KRIS_SYNC_KEY=
KRIS_SYNC_DAYS=120
# Optional: restrict Geoform pulls to these IMOs (comma-separated). Default: every IMO seen in Veson data.
KRIS_IMOS=

# Behaviour
KRIS_DATE_ORDER=DMY
KRIS_EXPOSE_SQL=0
KRIS_ALLOW_ORIGIN=*

KRIS_MODE=agent                     # agent (model + tools, default) | router
KRIS_RATE_PER_MIN=20                # messages per user per minute, per server process; 0 = off
KRIS_ENABLE_LLM=1
# The model is GLM-5.3-Flash (z-ai/glm-5.3-flash) on OpenRouter. The key is the only required setting.
KRIS_LLM_API_KEY=
KRIS_LLM_TIMEOUT_MS=30000           # longest the model may stay silent; a long streamed answer is never cut off
# KRIS_LLM_REASONING_EFFORT=        # pin low | medium | high; unset = follows the question
# Self-hosting instead: KRIS_LLM_PROVIDER=ollama|openai_compat, KRIS_LLM_URL=..., KRIS_LLM_MODEL=...
KRIS_APP_NAME="Shuddha Now"
KRIS_DEV_SESSION=1

