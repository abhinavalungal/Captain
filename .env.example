# K.R.1.S settings. Copy this file to .env and fill in the values.
# NEVER put real values in this file: it is committed to a public repo.

# --- Database (Supabase) -------------------------------------------------------
# Always use the pooler host, never db.<ref>.supabase.co (IPv6-only).
# Format: postgresql://<role>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Admin connection, only for `node db/setup.js`. Never set it on a hosted server.
DATABASE_URL=
# Written by `node db/setup.js`.
KRIS_READ_URL=
KRIS_WRITE_URL=
# true
KRIS_PG_SSL=

# --- Sign-in -------------------------------------------------------------------
# 1 = prototype sign-in (demo only). Blank = production: every question is refused until verifyToken() is wired.
KRIS_DEV_SESSION=
# Which sites may embed the widget: * or https://your-site.com (comma-separated)
KRIS_ALLOW_ORIGIN=

# --- Model (OpenRouter) --------------------------------------------------------
# OpenRouter key: the only required model setting
KRIS_LLM_API_KEY=
# Defaults: openai_compat / https://openrouter.ai/api / z-ai/glm-5.3-flash / 30000
KRIS_LLM_PROVIDER=
KRIS_LLM_URL=
KRIS_LLM_MODEL=
KRIS_LLM_TIMEOUT_MS=
# 0 = run without the model
KRIS_ENABLE_LLM=
# agent (default) | router
KRIS_MODE=

# --- Behaviour -----------------------------------------------------------------
# How K.R.1.S names your app
KRIS_APP_NAME=
# DMY (default) | MDY
KRIS_DATE_ORDER=
# 1 = send generated SQL to the browser
KRIS_EXPOSE_SQL=
# messages per user per minute (default 20, 0 = off)
KRIS_RATE_PER_MIN=
# read connections per server process (default 10)
KRIS_PG_POOL_MAX=
# default 8787
PORT=

# --- Sync (Veson + Geoform) ----------------------------------------------------
# Long random string that guards POST /api/kris-sync
KRIS_SYNC_KEY=
# 1 = sync on startup and every KRIS_SYNC_INTERVAL_MS (default 1 h)
KRIS_AUTO_SYNC=
KRIS_SYNC_INTERVAL_MS=
# days of Geoform history to pull (default 120)
KRIS_SYNC_DAYS=
# optional comma-separated IMO list (default: every IMO in Veson)

