# Captain — runtime secrets. Never commit this file. Rotate any token that has
# been pasted into a chat, ticket, or email.

# Database (two roles, see db/001_captain.sql)
CAPTAIN_READ_URL=postgres://captain_reader:PASSWORD@HOST/DB?sslmode=require
CAPTAIN_WRITE_URL=postgres://captain_writer:PASSWORD@HOST/DB?sslmode=require
CAPTAIN_PG_SSL=true

# Veson IMOS
VESON_API_TOKEN=
VESON_LEGWISE_API=https://api.veslink.com/v1/imos/reports/FuelEU_Leg_Wise
VESON_OFFHIRE_API=https://api.veslink.com/v1/imos/reports/FuelEU_Off_Hire

# Geoform
GEOFORM_API=https://perform.geoserves.com/api/library/api/v1.1/getallforms
GEOFORM_API_KEY_HEADER=library-api
GEOFORM_API_KEY=

# Sync
CAPTAIN_SYNC_KEY=
CAPTAIN_SYNC_DAYS=120
# Optional: restrict Geoform pulls to these IMOs (comma-separated). Default: every IMO seen in Veson data.
CAPTAIN_IMOS=

# Behaviour
CAPTAIN_DATE_ORDER=DMY
CAPTAIN_EXPOSE_SQL=0
CAPTAIN_ALLOW_ORIGIN=

# Companion / conversation layer — self-hosted, open-source, no paid API.
# Install Ollama (https://ollama.com), then:  ollama pull llama3.1:8b
# The URL must be reachable from wherever the backend runs. For Netlify
# Functions that means a server with a public or VPN address, not localhost.
# Set CAPTAIN_ENABLE_LLM=0 to run without a model: data, guide and briefing
# all still work; open-ended chat gets a fixed reply instead.
CAPTAIN_ENABLE_LLM=1
CAPTAIN_LLM_PROVIDER=ollama            # ollama | openai_compat (vLLM, llama.cpp, LM Studio, LocalAI)
CAPTAIN_LLM_URL=http://127.0.0.1:11434
CAPTAIN_LLM_MODEL=llama3.1:8b          # or qwen2.5:7b, mistral:7b, phi3:mini ...
CAPTAIN_LLM_API_KEY=                   # only if your own server requires one
CAPTAIN_LLM_TIMEOUT_MS=25000
CAPTAIN_APP_NAME=Geo Monitor
