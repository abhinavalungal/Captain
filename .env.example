
KRIS_READ_URL=postgres://kris_reader:PASSWORD@HOST/DB?sslmode=require
KRIS_WRITE_URL=postgres://kris_writer:PASSWORD@HOST/DB?sslmode=require
KRIS_PG_SSL=true

# Veson IMOS
VESON_API_TOKEN=
VESON_LEGWISE_API=https://api.veslink.com/v1/imos/reports/FuelEU_Leg_Wise
VESON_OFFHIRE_API=https://api.veslink.com/v1/imos/reports/FuelEU_Off_Hire

# Geoform
GEOFORM_API=https://perform.geoserves.com/api/library/api/v1.1/getallforms
GEOFORM_API_KEY_HEADER=library-api
GEOFORM_API_KEY=

# Sync
KRIS_SYNC_KEY=
KRIS_SYNC_DAYS=120
# Optional: restrict Geoform pulls to these IMOs (comma-separated). Default: every IMO seen in Veson data.
KRIS_IMOS=

# Behaviour
KRIS_DATE_ORDER=DMY
KRIS_EXPOSE_SQL=0
KRIS_ALLOW_ORIGIN=*

KRIS_ENABLE_LLM=1
KRIS_LLM_PROVIDER=ollama            # ollama | openai_compat (vLLM, llama.cpp, LM Studio, LocalAI)
KRIS_LLM_URL=http://127.0.0.1:11434
KRIS_LLM_MODEL=llama3.1:8b          # or qwen2.5:7b, mistral:7b, phi3:mini ...
KRIS_LLM_API_KEY=                   # only if your own server requires one
KRIS_LLM_TIMEOUT_MS=25000
KRIS_APP_NAME="Shuddha now"


