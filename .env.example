
KRIS_READ_URL=postgres://kris_reader:PASSWORD@HOST/DB?sslmode=require
KRIS_WRITE_URL=postgres://kris_writer:PASSWORD@HOST/DB?sslmode=require
KRIS_PG_SSL=true

# Veson IMOS
VESON_API_TOKEN=
VESON_LEGWISE_API=https://api.veslink.com/v1/imos/reports/FuelEU_Leg_Wise
VESON_OFFHIRE_API=https://api.veslink.com/v1/imos/reports/FuelEU_Off_Hire

# Geoform
GEOFORM_API=https://perform.geoserves.com/api/library/api/v1.1/getallforms
GEOFORM_API_KEY_HEADER=library-api
GEOFORM_API_KEY=

# Sync
KRIS_SYNC_KEY=
KRIS_SYNC_DAYS=120
# Optional: restrict Geoform pulls to these IMOs (comma-separated). Default: every IMO seen in Veson data.
KRIS_IMOS=

# Behaviour
KRIS_DATE_ORDER=DMY
KRIS_EXPOSE_SQL=0
KRIS_ALLOW_ORIGIN=*

KRIS_MODE=agent                     # agent (model + tools, default) | router
KRIS_ENABLE_LLM=1
# The model is GLM-5.3-Flash (z-ai/glm-5.3-flash) on OpenRouter. The key is the only required setting.
KRIS_LLM_API_KEY=
KRIS_LLM_TIMEOUT_MS=30000           # longest the model may stay silent; a long streamed answer is never cut off
# KRIS_LLM_REASONING_EFFORT=        # pin low | medium | high; unset = follows the question
# Self-hosting instead: KRIS_LLM_PROVIDER=ollama|openai_compat, KRIS_LLM_URL=..., KRIS_LLM_MODEL=...
KRIS_APP_NAME="Shuddha Now"
KRIS_DEV_SESSION=1

